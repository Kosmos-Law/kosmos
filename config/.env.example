# Every variable Kosmos reads, with what it does.
#
# This file is a reference, not a starting point. For a working config/.env,
# copy config/.env.dev (or let scripts/install.sh generate one) and bring
# over the settings you need from here.
#
# [string] and [boolean] mark values with no default: the app will not start
# without them. Everything else is optional. A variable shown commented out
# has a non-empty default; leave the line out of config/.env to keep it,
# because an empty value overrides the default.
#
# docs/reference/environment.md is generated from this file and
# config/settings.py by scripts/gen_docs_reference.py. A test fails when a
# variable is read by the app but missing here, or listed here but unused.
# Section titles are the "# === Title ===" lines; the comment directly
# above a variable becomes its description.

# === Core ===

# Django's secret key. Generate one with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=[string]

# Django debug mode. Always False in production.
DEBUG=[boolean]

# Name of this environment: prod or dev. dev keeps login
# sessions in files under .dev-sessions/ and marks the interface as a
# development instance.
ENV=[string]

# Comma-separated host names the application answers to.
ALLOWED_HOSTS='127.0.0.1,localhost'

# Comma-separated full origins (scheme, host and port when not the default)
# trusted for form posts. Needed behind a reverse proxy.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Scheme and host used to build absolute links outside a web request, such
# as payment links in emails sent by the background worker. Blank falls back
# to the host of the request that triggered the send, when there is one.
PUBLIC_BASE_URL=

# The firm's time zone, as a tz database name (for example America/Chicago).
# Dates shown in the app, the times scheduled jobs run, and the zone events
# are written to Google Calendar in all follow it.
# TIME_ZONE=America/New_York

# === Database ===

# PostgreSQL database name.
DB_NAME=[string]

# PostgreSQL role. It must own the database.
DB_USER=[string]

# Password for that role.
DB_PASSWORD=[string]

# Database host.
DB_HOST=localhost

# Database port.
DB_PORT=5432

# === Email ===

# How outgoing mail is delivered: console (print to the process log, no
# credentials needed), smtp, or locmem (tests). Defaults to console when
# DEBUG is on and smtp when it is off.
EMAIL_BACKEND=console

# SMTP server host.
EMAIL_HOST=

# SMTP server port.
EMAIL_PORT=587

# Use STARTTLS on the SMTP connection.
EMAIL_USE_TLS=True

# Seconds before a stalled SMTP connection is abandoned. Login codes are
# sent during the request, so a hung connection would otherwise hang the
# login page.
EMAIL_TIMEOUT=10

# SMTP user name.
EMAIL_HOST_USER=

# SMTP password.
EMAIL_HOST_PASSWORD=

# From address for error reports sent to ADMINS.
SERVER_EMAIL=webmaster@localhost

# From address for mail the application sends. Defaults to SERVER_EMAIL.
DEFAULT_FROM_EMAIL=webmaster@localhost

# From address for client-facing billing mail (invoices and payment
# requests). Defaults to DEFAULT_FROM_EMAIL.
BILLING_FROM_EMAIL=webmaster@localhost

# People who receive error emails, as a Python list of (name, address)
# tuples.
ADMINS="[('John Doe', 'john@mail.com')]"

# === File storage ===

# Where uploaded files are kept: local (the media/ directory) or s3 (an
# S3-compatible object store). With local storage, never serve media/
# directly from the web server: it holds confidential client documents, and
# the application streams them only to signed-in users.
STORAGE_BACKEND=local

# Object store region. Required when STORAGE_BACKEND=s3, as are the four
# settings below. The names say DigitalOcean; any S3-compatible store works.
DIGITAL_OCEAN_REGION_NAME=

# Object store endpoint URL.
DIGITAL_OCEAN_ENDPOINT_URL=

# Bucket name.
DIGITAL_OCEAN_BUCKET_NAME=

# Access key id.
DIGITAL_OCEAN_ACCESS_KEY_ID=

# Secret access key.
DIGITAL_OCEAN_SECRET_ACCESS_KEY=

# === Google Workspace ===

# Directory holding the Google OAuth client file (google_tokens.json) and
# the tokens generated when an integration is connected. A relative path is
# resolved from the repository root.
GOOGLE_DATA_DIR=google

# Id of the Google Calendar that events sync with.
CALENDAR_ID=

# Name of the Drive folder that holds one subfolder per matter.
DRIVE_NOTES_ROOT=Matters - Open

# Shared Drive id. Set only when the root folder lives in a Shared Drive.
DRIVE_SHARED_DRIVE_ID=

# Parent Gmail label whose child labels can be linked to matters. Blank
# offers every user label in the mailbox.
GMAIL_LABEL_ROOT=Matters - Open

# === Drafting (LibreOffice) ===

# Headless LibreOffice binary for the server-side redline module
# (apps/drive/redline.py). Drafting does not currently use that module:
# edits are applied by the companion extension in the user's LibreOffice.
# SOFFICE_BIN=soffice

# A Python interpreter that has the UNO bindings (the system python3 with
# the python3-uno package), not the project virtualenv. Used only by the
# same server-side redline module.
# UNO_PYTHON=/usr/bin/python3

# === AI and research ===

# AI is optional: with neither key set, every AI feature is hidden. Either
# provider runs all of them; with both, background work uses Gemini. A key
# can also be entered under Settings > Integrations; a key here wins.

# Anthropic API key, for the Claude models.
ANTHROPIC_API_KEY=

# Google Gemini API key, for the Gemini models and for the embeddings
# behind semantic search (the one feature only Gemini provides).
GEMINI_API_KEY=

# Re-embed a record for semantic search whenever it is saved. The built-in
# default is True; nothing is queued while no Gemini key is set. After
# setting one, run manage.py build_semantic_index once.
SEMANTIC_AUTO_INDEX=False

# CourtListener API token, for case law search and citation checking.
COURTLISTENER_API_KEY=

# Days after a matter closes before the weekly purge deletes its AI chats.
# 0 keeps them indefinitely.
CHAT_RETENTION_DAYS=180

# === Intakes ===

# Shared secret for the intake API used by a connected website or intake
# application (the X-Seam-Key header). While blank, that API refuses every
# request.
KOSMOS_SEAM_KEY=

# Mailgun HTTP webhook signing key, verifying inbound mail posted to
# /api/inbound-email/. While blank, that webhook refuses every request.
MAILGUN_WEBHOOK_SIGNING_KEY=

# The part before the @ of the address this instance accepts forwarded
# intake mail on. Mail for any other address is dropped, which lets several
# instances share one Mailgun route.
INTAKE_INBOUND_RECIPIENT=kosmos-intakes

# Seconds a client intake-form link stays valid. Defaults to 30 days.
INTAKE_FORM_LINK_MAX_AGE=2592000

# === Billing and payments ===

# The firm's id in LEDES invoice exports.
LAW_FIRM_ID=

# Which processor collects online payments: none (online payment off; the
# emailed link still shows the invoice), lawpay, stripe, confido, or fake.
# fake is for development: it records a payment although no money moves, so
# never run it where real clients receive invoices. The built-in default is
# fake; the installer sets none for a production install.
PAYMENT_PROCESSOR=none

# Seconds an emailed payment link stays valid. Defaults to 90 days.
# Resending the invoice issues a fresh link.
INVOICE_PAY_LINK_MAX_AGE=7776000

# LawPay (AffiniPay) public key, used in the browser by the hosted card
# fields. Test keys reach only test accounts.
LAWPAY_PUBLIC_KEY=

# LawPay secret key, used by the server.
LAWPAY_SECRET_KEY=

# LawPay deposit account for card payments to the operating account. List
# the account ids with manage.py lawpay_accounts. Blank lets the gateway
# pick its primary account; the same applies to the three settings below.
LAWPAY_OPERATING_CARD_ACCOUNT_ID=

# LawPay deposit account for eCheck payments to the operating account.
LAWPAY_OPERATING_ECHECK_ACCOUNT_ID=

# LawPay deposit account for card payments to the trust account. Required
# before a trust deposit request can be sent: a trust charge is never left
# to the gateway's choice of account.
LAWPAY_TRUST_CARD_ACCOUNT_ID=

# LawPay deposit account for eCheck payments to the trust account.
LAWPAY_TRUST_ECHECK_ACCOUNT_ID=

# LawPay API host. Change only if AffiniPay moves it.
# LAWPAY_API_BASE=https://api.8am.com

# Stripe publishable key, used in the browser. The firm supplies keys for
# its own Stripe account.
STRIPE_PUBLISHABLE_KEY=

# Stripe secret key, used by the server.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for the /webhooks/stripe/ endpoint.
STRIPE_WEBHOOK_SECRET=

# Confido Legal (Gravity Legal) API key.
CONFIDO_API_KEY=

# Confido webhook signing secret for the /webhooks/confido/ endpoint.
CONFIDO_WEBHOOK_SECRET=

# Confido bank account id that invoice payments are deposited to. Confido
# has no default account, so both account ids are required.
CONFIDO_OPERATING_BANK_ACCOUNT_ID=

# Confido bank account id that trust deposits go to.
CONFIDO_TRUST_BANK_ACCOUNT_ID=

# Confido API endpoint. The default is the sandbox; for live payments set
# https://api.gravity-legal.com/v2
# CONFIDO_API_BASE=https://api.sandbox.gravity-legal.com/v2

# Confido hosted-fields script. The default is the sandbox; for live
# payments set https://js.gravity-legal.com/hosted-fields.js
# CONFIDO_HOSTED_FIELDS_URL=https://js.sandbox.gravity-legal.com/hosted-fields.js
