[Unit]
Description=Kosmos sessions service: runs Claude Code turns for AI sessions
After=network-online.target postgresql.service

[Service]
User=@USER@
Group=@USER@
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/.venv/bin/python manage.py run_sessions
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
