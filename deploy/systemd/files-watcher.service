[Unit]
Description=Kosmos files watcher (synced Firm tree: OCR in place, folder links)
After=network.target postgresql.service

[Service]
User=@USER@
Group=@USER@
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/.venv/bin/python manage.py watch_files
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
